OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# The app listens on loopback only. Set 0.0.0.0 to expose it to your network;
# anyone who can reach it can use your OpenAI key and see your wardrobe.
# WARDROBE_HOST=127.0.0.1

# Vercel deployments only (set these in the Vercel dashboard, not here):
# WARDROBE_PASSWORD protects the deployed site with HTTP Basic Auth.
# BLOB_READ_WRITE_TOKEN is created automatically when you attach a Blob store.
